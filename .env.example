# Credenciais do Supabase usadas pelo APP (somente URL + anon key — NUNCA o service_role aqui)
MAIN_VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
MAIN_VITE_SUPABASE_ANON_KEY=eyJ...sua-anon-key

# A service_role key é usada APENAS para aplicar o schema (migrations), fora do app.
# Guarde-a em supabase/.env (gitignored), não aqui.
